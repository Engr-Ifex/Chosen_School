# Chosen School Website — environment variable template
#
# Copy this file to `.env`, then fill in real values locally. Never commit `.env`.
# Authoritative register and validation rules: docs/ENVIRONMENT_VARIABLES.md
#
# Render  consumes the "Server" block.
# Vercel  consumes the "Client" block (public — bundled into the browser).
# Backup  uses a separate file, `.env.backup`, on the developer machine only.
#
# Every value below is a placeholder written in angle brackets.
# None of them is a real credential. Replace each one before use.

# ── Server (Render) ──────────────────────────────────────────────────────────
# MONGODB_URI must be an Atlas SRV connection string containing retryWrites=true
# and w=majority. Build it from Atlas → Connect → Drivers.

MONGODB_URI="<atlas-srv-connection-string>"
MONGODB_DB_NAME="chosen_school"
NODE_ENV="production"
PORT="10000"
APP_ORIGIN="https://<your-project>.vercel.app"
SESSION_COOKIE_NAME="__Host-cs_session"
TRUST_PROXY_HOPS="2"
LOG_LEVEL="info"

R2_ACCOUNT_ID="<cloudflare-account-id>"
R2_ACCESS_KEY_ID="<r2-application-access-key-id>"
R2_SECRET_ACCESS_KEY="<r2-application-secret-access-key>"
R2_BUCKET_PRIVATE="admissions-private"
R2_BUCKET_PUBLIC="gallery-public"
R2_PUBLIC_BASE_URL="https://<r2-public-domain>"

# ── Client (Vercel) ──────────────────────────────────────────────────────────
# PUBLIC. Anything prefixed VITE_ is inlined into the browser bundle at build
# time. A secret placed here is a published secret.

VITE_API_BASE_URL="/api/v1"

# ── Backup job (local only — goes in .env.backup, never on Render) ───────────
# The application server must not hold these. A compromised API that can reach
# the backup bucket can delete the backups of the data it just corrupted.
# BACKUP_MONGODB_URI should use a read-only Atlas user, not the application user.

# BACKUP_MONGODB_URI="<atlas-srv-connection-string-read-only-user>"
# BACKUP_R2_ENDPOINT="https://<cloudflare-account-id>.r2.cloudflarestorage.com"
# BACKUP_R2_ACCESS_KEY_ID="<r2-backup-only-access-key-id>"
# BACKUP_R2_SECRET_ACCESS_KEY="<r2-backup-only-secret-access-key>"
# BACKUP_R2_BUCKET="backups"
# AGE_RECIPIENT="<age-public-key>"
# AGE_IDENTITY_FILE="<absolute-path-outside-this-repo>"
