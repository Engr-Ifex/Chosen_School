{
  "name": "@chosen-school/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env --env-file=.env.development src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "seed": "tsx --env-file=.env src/scripts/seed.ts",
    "sync-indexes": "tsx --env-file=.env src/scripts/sync-indexes.ts",
    "provision-admin": "tsx --env-file=.env src/scripts/provision-admin.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "express": "^5.3.0",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/multer": "^2.3.0",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
