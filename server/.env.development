# Local development overrides — loaded AFTER `.env` by the dev scripts only
# (`npm run dev:server` and the `*:dev` database scripts).
#
#   tsx --env-file=.env --env-file=.env.development src/index.ts
#
# Node applies later `--env-file` flags over earlier ones, so these values win
# locally while the remaining settings (Supabase, buckets, port) still come from
# `server/.env`. That file is never modified by development.
#
# This file contains no secrets, so it is committed. Production does not read
# it: `npm start` is `node dist/index.js` with no `--env-file`, and Render
# supplies `NODE_ENV=production` and the Vercel origin from its own environment.

NODE_ENV="development"

# Must be the URL the browser actually uses, or the origin check rejects every
# local mutation with 403.
APP_ORIGIN="http://localhost:5173"

# Development has its own database and never touches Atlas (ADR-035). Start it
# with `npm run dev:db`. Boot refuses a non-local MONGODB_URI in development
# unless ALLOW_REMOTE_DEV_DB=true.
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB_NAME="chosen_school_dev"
