# Local development overrides — loaded AFTER `.env` by the dev script only.
#
#   tsx --env-file=.env --env-file=.env.development src/index.ts
#
# Node applies later `--env-file` flags over earlier ones, so these two values
# win locally while every other setting (Atlas, Supabase, buckets, port) still
# comes from `server/.env`. That file is never modified by development.
#
# This file contains no secrets, so it is committed. Production does not read
# it: `npm start` is `node dist/index.js` with no `--env-file`, and Render
# supplies `NODE_ENV=production` and the Vercel origin from its own environment.

NODE_ENV="development"

# Must be the URL the browser actually uses, or the origin check rejects every
# local mutation with 403.
APP_ORIGIN="http://localhost:5173"
